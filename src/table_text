CREATE TABLE LOL_QNA(
        GAME_NO NUMBER GENERATED BY DEFAULT AS IDENTITY,
        GAME_TITLE VARCHAR2(100) NOT NULL,
        GAME_CONTENT VARCHAR2(200) NOT NULL,
        GAME_WRITER VARCHAR2(100) NOT NULL,
        GAME_DATE DATE DEFAULT SYSDATE,
        GAME_hits NUMBER DEFAULT 0 NOT NULL,
        GAME_recommend NUMBER DEFAULT 0 NOT NULL,
        GAME_PASSWD VARCHAR2(18) NOT NULL,
        CONSTRAINT LOL_QNA_PK PRIMARY KEY(GAME_NO)
);

